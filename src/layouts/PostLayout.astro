---
type Author = { name: string; href?: string; affiliation?: string }
type LinkItem = { label: string; href: string }

interface Props {
	pageTitle?: string
	title: string
	subtitle?: string
	authors?: Author[]
	links?: LinkItem[]
	hero?: string
	heroVideo?: string
	heroAlt?: string
	description?: string
	faviconHref?: string
}

const {
	pageTitle,
	title,
	subtitle,
	authors = [],
	links = [],
	hero,
	heroVideo,
	heroAlt = title,
	description,
	faviconHref,
} = Astro.props
---

<!doctype html>
<html lang='en'>
	<head>
		<meta charset='utf-8' />
		<meta name='viewport' content='width=device-width,initial-scale=1' />
		{faviconHref && <link rel='icon' type='image/png' href={faviconHref} />}
		<link rel='preconnect' href='https://fonts.googleapis.com' />
		<link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
		<link
			rel='stylesheet'
			href='https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,300i,400,400i,600,600i,700,700i&display=swap'
		/>
		<link
			rel='stylesheet'
			href='https://fonts.googleapis.com/css?family=Source+Code+Pro:300,300i,400,400i,600,600i,700,700i&display=swap'
		/>
		<title>{pageTitle || title}</title>
		{description && <meta name='description' content={description} />}
		<meta property='og:title' content={pageTitle || title} />
		{description && <meta property='og:description' content={description} />}

		<script is:inline set:html={`
			window.MathJax = {
				tex: {
					inlineMath: [['$', '$'], ['\\\\(', '\\\\)']],
					displayMath: [['$$', '$$'], ['\\\\[', '\\\\]']],
					processEscapes: true
				},
				options: { skipHtmlTags: ['script','noscript','style','textarea','pre','code'] }
			};
		`} />
		<script
			is:inline
			id='MathJax-script'
			async
			src='https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js'
		></script>
	</head>
	<body>
		<div class='container'>
			<div class='row hero-row'>
				<h1 class='page-title'>{title}</h1>
				{subtitle && <p class='page-subtitle'>{subtitle}</p>}
			</div>

			{authors.length > 0 && (
				<div class='row'>
					<ul class='author-list'>
						{authors.map((a) => (
							<li>
								{a.href ? <a href={a.href}>{a.name}</a> : <span>{a.name}</span>}
								{a.affiliation && (
									<>
										<br />
										<span class='affiliation'>{a.affiliation}</span>
									</>
								)}
							</li>
						))}
					</ul>
				</div>
			)}

			{links.length > 0 && (
				<div class='row'>
					<ul class='link-list'>
						{links.map((l) => (
							<li>
								<a href={l.href}>
									<h3 class='top-link'>{l.label}</h3>
								</a>
							</li>
						))}
					</ul>
				</div>
			)}

			{(heroVideo || hero) && (
				<div class='row'>
					<div class='hero-container'>
						{heroVideo ? (
							<video class='hero-media' autoplay loop muted playsinline>
								<source src={heroVideo} type='video/mp4' />
							</video>
						) : (
							<img class='hero-media' src={hero} alt={heroAlt} />
						)}
					</div>
				</div>
			)}

			<div class='post'>
				<slot />
			</div>

			<p class='footer-credit'>
				Website style adapted from{' '}
				<a href='https://seohong.me/projects/ogbench/'>Seohong Park</a> /{' '}
				<a href='http://mgharbi.com/'>Michaël Gharbi</a> /{' '}
				<a href='https://jonbarron.info/'>Jon Barron</a>.
			</p>
		</div>
	</body>
</html>

<style is:global>
	:root {
		--link: #598be7;
		--link-hover: #9bb9f1;
		--fg: #000;
		--bg: #fff;
		--muted: #555;
		--border: #e6e6e6;
		--code-bg: #f6f8fa;
		--block-border: #e75964;
		--block-bg: #fdf1f2;
		--caption-color: #555;
		--accent: #e75964;
	}

	html,
	body {
		margin: 0;
		padding: 0;
		background: var(--bg);
		color: var(--fg);
	}

	body {
		font-family: 'Source Sans Pro', 'Lato', Verdana, Helvetica, sans-serif;
		font-size: 18px;
		font-weight: 400;
		-webkit-font-smoothing: antialiased;
		line-height: 1.55;
	}

	a,
	a:focus {
		color: var(--link);
		text-decoration: none;
	}
	a:hover {
		color: var(--link-hover);
		text-decoration: none;
	}

	strong,
	b {
		font-weight: 700;
	}

	.container {
		max-width: 1100px;
		margin: 0 auto;
		padding: 30px 20px 80px;
	}

	.row {
		margin: 0 0 8px 0;
	}

	.hero-row {
		margin-top: 20px;
	}

	.page-title {
		text-align: center;
		font-weight: 600;
		font-size: 39px;
		margin: 30px 0 24px;
		line-height: 1.15;
	}

	.author-list,
	.link-list {
		list-style: none;
		padding: 0;
		margin: 0 0 14px 0;
		text-align: center;
	}

	.author-list > li {
		display: inline-block;
		margin: 0 12px 8px;
		text-align: center;
		vertical-align: top;
		line-height: 1.3;
	}

	.author-list .affiliation {
		color: var(--muted);
		font-size: 0.92em;
	}

	.link-list > li {
		display: inline-block;
		margin: 0 8px;
	}

	.top-link {
		display: inline-block;
		margin: 10px 0;
		padding: 4px 14px;
		font-size: 22px;
		font-weight: 400;
		color: var(--link);
	}
	a:hover .top-link {
		color: var(--link-hover);
	}

	.hero-container {
		max-width: 1000px;
		margin: 24px auto 16px;
	}

	.hero-media {
		width: 100%;
		height: auto;
		display: block;
		margin: 0 auto;
		border-radius: 4px;
	}

	h1 {
		font-weight: 300;
		font-size: 42px;
		margin: 52px 0 18px;
		line-height: 1.2;
	}

	.sec-sub {
		display: block;
		font-size: 0.6em;
		font-weight: 400;
		color: var(--muted);
		margin-top: 8px;
	}

	h2 {
		font-weight: 600;
		font-size: 26px;
		margin: 28px 0 12px;
	}

	h3 {
		font-weight: 600;
		margin: 20px 0 10px;
		font-size: 22px;
	}

	p,
	ul,
	ol {
		margin: 0 0 14px 0;
	}

	ul li,
	ol li {
		margin-bottom: 6px;
	}

	hr {
		border: none;
		border-top: 1px solid var(--border);
		margin: 40px 0 24px;
	}

	pre.codebox,
	pre {
		font-size: 15px;
		background: var(--code-bg);
		border: none;
		border-radius: 6px;
		padding: 16px;
		overflow-x: auto;
		margin: 14px 0;
	}

	code {
		font-family: 'Source Code Pro', ui-monospace, monospace;
		background: var(--code-bg);
		padding: 1px 4px;
		border-radius: 3px;
		font-size: 0.95em;
	}

	pre code {
		padding: 0;
		background: transparent;
		font-size: 1em;
	}

	.text-tt {
		font-family: 'Source Code Pro', ui-monospace, monospace;
		font-weight: 600;
		font-size: 0.92em;
	}

	.text-red {
		color: #f54254;
	}

	.text-blue {
		color: var(--link);
	}

	.muted {
		color: var(--muted);
	}

	.data-note {
		color: var(--muted);
		font-size: 15px;
		font-style: italic;
		line-height: 1.55;
		margin: 6px 0 18px;
		padding-left: 12px;
		border-left: 2px solid var(--border);
	}

	.lead {
		font-weight: 600;
		font-size: 1.04em;
		line-height: 1.5;
		margin: 0 0 16px;
	}

	.results-glance {
		text-align: center;
		color: var(--muted);
		font-size: 16px;
		line-height: 1.8;
		margin: 4px auto 24px;
		max-width: 760px;
	}

	.results-glance b {
		color: var(--fg);
	}

	.block-statement {
		margin: 30px auto;
		max-width: 760px;
		text-align: center;
		color: var(--block-border);
		font-weight: 600;
		font-size: 20px;
		line-height: 1.5;
	}

	.tldr-box {
		background: var(--block-bg);
		border-left: 4px solid var(--block-border);
		padding: 18px 22px;
		border-radius: 6px;
		margin: 24px auto;
		max-width: 1000px;
	}

	.tldr-box h2 {
		margin-top: 0;
	}

	.figure {
		margin: 28px auto;
		max-width: 1000px;
	}

	.figure.fig-sm {
		max-width: 640px;
	}

	.figure img,
	.figure video {
		width: 100%;
		height: auto;
		display: block;
		border-radius: 4px;
	}

	.figure video {
		background: #000;
	}

	.caption {
		display: block;
		text-align: center;
		color: var(--caption-color);
		font-size: 16px;
		margin: 8px auto 0;
		max-width: 900px;
		line-height: 1.5;
	}

	.caption-muted {
		display: block;
		text-align: center;
		color: var(--muted);
		font-size: 15px;
		margin: 8px auto 0;
		max-width: 900px;
		line-height: 1.5;
	}

	.grid-2 {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 24px;
		margin: 28px 0;
	}

	.grid-3 {
		display: grid;
		grid-template-columns: 1fr 1fr 1fr;
		gap: 20px;
		margin: 28px 0;
	}

	.grid-2 .figure,
	.grid-3 .figure {
		margin: 0;
		max-width: none;
	}

	.footer-credit {
		color: var(--muted);
		text-align: center;
		font-size: 14px;
		margin-top: 48px;
	}

	.results-table {
		margin: 28px auto;
		max-width: 900px;
	}

	.results-table table {
		width: 100%;
		border-collapse: collapse;
		font-size: 16px;
	}

	.results-table thead th {
		text-align: left;
		padding: 10px 14px;
		background: #f6f8fa;
		border-bottom: 2px solid var(--border);
		font-weight: 600;
	}

	.results-table tbody td {
		padding: 10px 14px;
		border-bottom: 1px solid var(--border);
		vertical-align: top;
	}

	.results-table tbody tr:last-child td {
		border-bottom: none;
	}

	.results-table tbody td:last-child {
		text-align: right;
		font-variant-numeric: tabular-nums;
	}

	.results-table .caption-muted {
		margin-top: 10px;
	}

	.trc-logo {
		max-width: 460px;
		margin: 18px auto;
	}

	.trc-logo img {
		width: 100%;
		height: auto;
		display: block;
	}

	@media (max-width: 991px) {
		body {
			font-size: 16px;
		}
		.page-title {
			font-size: 32px;
		}
		h1 {
			font-size: 30px;
		}
		h2 {
			font-size: 22px;
		}
		.top-link {
			font-size: 18px;
		}
		.grid-2,
		.grid-3 {
			grid-template-columns: 1fr;
		}
		.block-statement {
			font-size: 16px;
		}
	}

	/* Fundamental Theory: the figures' red accents, and a text column narrower than the figures */
	.page-subtitle {
		text-align: center;
		color: var(--muted);
		font-style: italic;
		font-size: 20px;
		margin: -10px 0 14px;
	}

	.post > *:not(.figure):not(.table-wrap) {
		max-width: 820px;
		margin-left: auto;
		margin-right: auto;
	}

	.post h1 {
		font-size: 32px;
		font-weight: 400;
	}

	.post .caption {
		text-align: left;
		font-size: 15px;
		max-width: 940px;
	}

	.figure a {
		display: block;
	}

	.nowrap {
		white-space: nowrap;
	}

	.caption .fig-num {
		color: var(--accent);
		font-weight: 700;
	}

	.remark {
		background: var(--block-bg);
		border-left: 4px solid var(--accent);
		border-radius: 6px;
		padding: 12px 18px;
		margin-top: 18px;
		margin-bottom: 18px;
	}

	.tldr-box p:last-child,
	.tldr-box ul:last-child,
	.remark p:last-child,
	blockquote p:last-child {
		margin-bottom: 0;
	}

	.qa {
		border-left: 3px solid var(--accent);
		padding: 2px 0 2px 14px;
	}

	blockquote {
		margin-top: 18px;
		margin-bottom: 18px;
		padding: 2px 18px;
		border-left: 3px solid var(--border);
		color: #333;
		font-style: italic;
	}

	.table-wrap {
		max-width: 1000px;
		margin: 24px auto;
		overflow-x: auto;
	}

	.table-wrap table {
		width: 100%;
		border-collapse: collapse;
		font-size: 16px;
		line-height: 1.45;
	}

	.table-wrap th {
		text-align: left;
		padding: 9px 12px;
		background: var(--code-bg);
		border-bottom: 2px solid var(--border);
		font-weight: 600;
	}

	.table-wrap td {
		padding: 9px 12px;
		border-bottom: 1px solid var(--border);
		vertical-align: top;
	}

	.series-note {
		color: var(--muted);
		margin-top: 40px;
	}

	@media (max-width: 991px) {
		.post h1 {
			font-size: 26px;
		}
		.page-subtitle {
			font-size: 17px;
		}
	}
</style>
