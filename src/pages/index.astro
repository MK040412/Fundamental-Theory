---
import { Image } from 'astro:assets'
import Layout from '../layouts/Layout.astro'
import { posts, type Post } from '../data/posts'
import Logo from '../assets/logo.png'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')

function formatDate(iso: string): string {
	const d = new Date(iso)
	if (Number.isNaN(d.getTime())) return iso
	return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
}
---

<Layout>
	<table class='outer'>
		<tbody>
			<tr>
				<td>
					<table class='header-table'>
						<tbody>
							<tr>
								<td class='header-text-cell'>
									<p class='name'>Fundamental Theory</p>
									<p class='bio'>
										<strong>Fundamental Theory</strong> is a series of first-principles notes on the
										theory behind modern machine learning, starting with
										<a href='#posts'>diffusion models</a>. Each post asks one question a reader
										actually asks, answers it in its first sentence, and shows a figure before every
										derivation.
									</p>
									<p class='contact-line'>
										<a href='https://mk040412.github.io/'>Maintainer: Kang Minkyu</a>
									</p>
								</td>
								<td class='header-photo-cell'>
									<Image src={Logo} alt='The swiss roll of the first diffusion paper' class='profile-photo' />
								</td>
							</tr>
						</tbody>
					</table>

					<table class='section-table' id='posts'>
						<tbody>
							<tr>
								<td class='section-cell'>
									<h2>Posts</h2>
								</td>
							</tr>
						</tbody>
					</table>

					<table class='entries-table'>
						<tbody>
							{posts.map((p: Post) => (
								<tr style={p.highlight ? 'background-color:#ffffd0;' : undefined}>
									<td class='thumb-cell'>
										<img src={`${base}${p.image}`} alt={p.title} class='thumb' />
									</td>
									<td class='entry-cell'>
										<a href={`${base}${p.link}`}>
											<span class='papertitle'>{p.title}</span>
										</a>
										<br />
										<span class='post-meta'>{formatDate(p.date)}</span>
										{p.tags && p.tags.length > 0 && (
											<span class='post-tags'>
												{p.tags.map((t) => (
													<>
														{' · '}
														<span class='tag'>{t}</span>
													</>
												))}
											</span>
										)}
										<p class='excerpt'>{p.tagline}</p>
									</td>
								</tr>
							))}
						</tbody>
					</table>

					<p class='footer-credit'>
						Maintained by <a href='https://mk040412.github.io/'>Kang Minkyu</a>.
					</p>
				</td>
			</tr>
		</tbody>
	</table>
</Layout>
